{
  "name": "ia-uploader-backend",
  "version": "1.0.0",
  "description": "Backend API for Internet Archive Uploader",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:browser": "cd ../frontend && NODE_PATH=../backend/node_modules ../backend/node_modules/.bin/esbuild blob-client-entry.js --bundle --minify --format=iife --global-name=IAUploaderBlobModule --outfile=blob-client.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=18.x"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
